        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"factual_accuracy\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"evidence_sufficiency\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"rubric_consistency\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"hallucination_detected\": {\n      \"type\": \"boolean\"\n    },\n    \"approved\": {\n      \"type\": \"boolean\"\n    },\n    \"critique\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"factual_accuracy\",\n    \"evidence_sufficiency\",\n    \"rubric_consistency\",\n    \"hallucination_detected\",\n    \"approved\",\n    \"critique\"\n  ]\n}"
